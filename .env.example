PORT=3000
# Cliente OAuth do Google (tipo "Aplicativo da Web"). Alternativa ao arquivo
# config/oauth2-credentials.json. No Google Cloud, cadastre como URI de
# redirecionamento: SERVER_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: a conta e a pasta agora são escolhidas pelo botão "Entrar no Drive"
GOOGLE_DRIVE_FOLDER_ID=
# URL pública do servidor (usada para gerar o QR Code).
# Substitua pelo domínio real do EasyPanel/servidor.
SERVER_URL=https://SEU_DOMINIO_AQUI
